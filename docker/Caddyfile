# TLS-Endpunkt vor dem Spielserver.
#
# Caddy holt und erneuert das Zertifikat selbst, sobald die Domain auf diese
# Maschine zeigt und die Ports 80 und 443 von außen erreichbar sind. Mehr ist
# hier nicht zu tun — die WebSocket-Aufwertung reicht `reverse_proxy` von
# sich aus durch.

{
	email {$AURELITH_ACME_MAIL}
}

{$AURELITH_DOMAIN} {
	encode zstd gzip

	# Der Spielverkehr. Lange Verbindungen, keine Zeitüberschreitung von
	# außen — der Server hat seine eigene, großzügig bemessen, weil Browser
	# Zeitgeber in Hintergrund-Tabs drosseln.
	reverse_proxy server:8787 {
		flush_interval -1
	}

	log {
		output stdout
		format console
	}
}
