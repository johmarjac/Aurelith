{
  "name": "aurelith",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browserbasiertes 3D-MMORPG. Autoritativer Server, geteilte Simulation, manifestgetriebenes Asset-Streaming.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/core",
    "packages/shared",
    "packages/server",
    "packages/client",
    "packages/editor"
  ],
  "scripts": {
    "dev": "node tools/dev.mjs",
    "core": "node tools/build-core.mjs",
    "core:test": "node tools/build-core.mjs --native",
    "maps": "node tools/gen-maps.mjs",
    "figur": "tsx tools/render-rig.mjs",
    "aura": "node tools/shot-aura.mjs",
    "dev:server": "npm run dev --workspace @aurelith/server",
    "dev:client": "npm run dev --workspace @aurelith/client",
    "dev:editor": "npm run dev --workspace @aurelith/editor",
    "build": "npm run core && npm run manifest && npm run build --workspace @aurelith/client",
    "manifest": "node tools/build-manifest.mjs",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p packages/core && tsc --noEmit -p packages/server && tsc --noEmit -p packages/client && tsc --noEmit -p packages/editor",
    "db:migrate": "npm run migrate --workspace @aurelith/server",
    "test": "npm run core:test && npm run test:wasm && npm run test:steering && npm run test:brushes && npm run test:particles && npm run test:gait && npm run test:audio && npm run test:tag && npm run test:quests && npm run test:content && npm run test:npcflow && node tools/smoke-e2e.mjs && node tools/smoke-npc.mjs && node tools/smoke-prediction.mjs && node tools/smoke-portal.mjs && node tools/smoke-background.mjs && node tools/smoke-editor.mjs && node tools/smoke-pages.mjs",
    "test:wasm": "tsx packages/core/test/wasm_smoke.ts",
    "test:steering": "tsx packages/client/test/steering_test.ts",
    "test:brushes": "tsx packages/editor/test/brushes_test.ts",
    "test:particles": "tsx packages/client/test/particles_test.ts",
    "test:gait": "tsx packages/client/test/gait_test.ts",
    "test:audio": "tsx packages/client/test/audio_test.ts",
    "test:tag": "tsx packages/client/test/daycycle_test.ts",
    "test:quests": "tsx packages/server/test/quests_test.ts",
    "test:content": "tsx packages/server/test/content_test.ts",
    "content": "tsx tools/export-content.mjs",
    "icons": "node tools/render-icons.mjs",
    "test:npcflow": "tsx packages/server/test/npcflow_test.ts",
    "test:npc": "node tools/smoke-npc.mjs",
    "audio": "node tools/pack-audio.mjs",
    "test:e2e": "node tools/smoke-e2e.mjs",
    "test:editor": "node tools/smoke-editor.mjs",
    "test:pages": "node tools/smoke-pages.mjs",
    "test:background": "node tools/smoke-background.mjs",
    "test:prediction": "node tools/smoke-prediction.mjs",
    "test:portal": "node tools/smoke-portal.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "ffmpeg-static": "^5.2.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
