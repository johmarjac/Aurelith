# Vorlage für den Serverbetrieb. Kopieren nach `.env`, ausfüllen, fertig.
#
#   cp .env.example .env
#
# `.env` ist in .gitignore — Passwörter gehören nicht ins Repository.

# Passwort der Datenbanken. Frei wählbar, aber nicht leer.
#
# Es gibt zwei Sorten: `db-master` hält die Konten und steht einmal auf der
# Welt, `db-eu` hält die Figuren dieser Region und steht bei ihren Kanälen.
# Eine zweite Region bekommt ihre eigene Weltdatenbank auf ihrer eigenen
# Maschine — hier steht nur, was in diesem Stapel läuft.
POSTGRES_PASSWORD=bitte-aendern

# Wohin der Spielport veröffentlicht wird.
#
# Standard ist die Loopback-Adresse: erreichbar für einen Reverse-Proxy auf
# derselben Maschine, aus dem Internet nicht. Läuft der Proxy in einem
# Container, hängt man ihn besser an das Netz `aurelith_default` und erreicht
# den Server unter `server:8787` — dann bleibt hier alles wie es ist.
#
# Wer den Port doch offen braucht: 0.0.0.0:8787
AURELITH_BIND=127.0.0.1:8787
AURELITH_KANAL2_BIND=127.0.0.1:8788
AURELITH_LOGIN_BIND=127.0.0.1:8790

# Das gemeinsame Geheimnis zwischen Anmeldeserver und Kanälen.
#
# Damit weist sich ein Kanal aus, wenn er sich in die Liste einträgt oder eine
# Eintrittskarte einlöst. Ohne das könnte jeder, der die internen Wege
# erreicht, einen eigenen Kanal anmelden und Spieler auf seinen Rechner
# locken. Frei wählbar, lang, und nicht dasselbe wie das Datenbankpasswort.
AURELITH_INTERNAL_SECRET=bitte-aendern

# Unter welchem Servernamen die Kanäle stehen. Die Überschrift links in der
# Kanalauswahl.
AURELITH_SERVER_NAME=Aurelith

# Was der **Client** eingeben muss, um einen Kanal zu erreichen — nicht, worauf
# der Server hört. Hinter einem Proxy sind das wss://-Adressen.
AURELITH_KANAL1_URL=ws://localhost:8787/ws
AURELITH_KANAL2_URL=ws://localhost:8788/ws

# Wie viele Spieler in einen Kanal passen. 0 heisst: keine Grenze.
AURELITH_CAPACITY=0

# Welches Bild gefahren wird. Ein Versionsschild statt `latest` ist im
# Betrieb die ruhigere Wahl — dann aktualisiert nichts unbemerkt.
AURELITH_IMAGE=ghcr.io/johmarjac/aurelith-server:latest

# Karte, auf der ein neuer Charakter anfängt.
AURELITH_START_MAP=lichtmoor

# Sekunden ohne Lebenszeichen, nach denen eine Sitzung fliegt.
AURELITH_SESSION_TIMEOUT=90
